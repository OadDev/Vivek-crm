APP_NAME="Vivek Jain CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# These DB_* values are placeholders — the Setup Wizard (/setup) will ask
# for your real MySQL credentials on first run and write them here for you.
# You do not need to edit this file by hand before installing.
#
# Running this app from more than one machine (e.g. a live Hostinger
# install and a local XAMPP install) against ONE shared database: put the
# exact same DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD in both
# machines' .env files (the Hostinger MySQL host, not XAMPP's local one).
# You'll need "Remote MySQL" enabled and your local IP allow-listed in
# Hostinger's hPanel first. See README.md.
#
# Optional hardening since DB traffic now crosses the public internet: set
# MYSQL_ATTR_SSL_CA below to a CA cert path if your host provides one —
# config/database.php already wires it in for the mysql connection, no code
# change needed.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# MYSQL_ATTR_SSL_CA=

# File-based session so the app can boot (and serve the Setup Wizard itself)
# even before any database tables exist; sessions are per-machine anyway,
# so there's no reason to share them between installs.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Database-backed (not file) cache so that when one install updates cached
# data (WhatsApp templates, Gmail settings, product reference tables), the
# other install sees it too — they already share the same MySQL database,
# so this needs no extra infrastructure. Nothing is cached before the first
# migration runs, so this is safe even during first-time setup.
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Gmail Integration — optional fallback only. The normal way to set this up
# is pasting the Client ID/Secret into Settings > Gmail Integration in the
# app itself (stored encrypted in the database); these env vars are only
# used if that page's fields are left empty. See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
